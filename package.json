{
  "name": "hand-math-3d",
  "version": "1.0.5",
  "description": "3D Hand Visualization for Mathematical Calculations",
  "main": "index.html",
  "scripts": {
    "generate-changelog": "node scripts/generateChangelog.js",
    "start": "npm run generate-changelog && http-server -p 8080 -o",
    "dev": "npm run generate-changelog && http-server -p 8080 -o --cors",
    "build": "npm run generate-changelog && echo 'Static files ready for production'",
    "serve": "npm run generate-changelog && python3 -m http.server 8080",
    "serve-alt": "python -m SimpleHTTPServer 8080",
    "test:server": "npm run generate-changelog && http-server -p 8080 -s -c-1",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:serial": "playwright test --workers=1",
    "test:parallel": "playwright test --workers=4",
    "test:debug": "playwright test --workers=1 --headed",
    "cap:prepare": "npm run generate-changelog && node scripts/prepare-www.js",
    "cap:sync": "npm run cap:prepare && cap sync android",
    "android:apk": "npm run cap:sync && cd android && JAVA_HOME=\"$(ls -d /opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home 2>/dev/null || /usr/libexec/java_home -v 21 2>/dev/null || echo \"$JAVA_HOME\")\" ./gradlew assembleDebug",
    "android:apk-release": "npm run cap:sync && cd android && JAVA_HOME=\"$(ls -d /opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home 2>/dev/null || /usr/libexec/java_home -v 21 2>/dev/null || echo \"$JAVA_HOME\")\" ./gradlew assembleRelease"
  },
  "keywords": [
    "3d",
    "three.js",
    "mathematics",
    "education",
    "hand-tracking",
    "visualization",
    "arithmetic"
  ],
  "author": "Muhammad Faiz",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@playwright/test": "^1.55.0",
    "http-server": "^14.1.1"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "."
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "dependencies": {
    "@capacitor/core": "^8.5.1"
  }
}
